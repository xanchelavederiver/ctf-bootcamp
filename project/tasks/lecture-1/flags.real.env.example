# Боевые флаги короткого CTF — ШАБЛОН для лектора.
#
# Как пользоваться:
#   1. Скопируйте этот файл рядом под именем flags.real.env
#        cp flags.real.env.example flags.real.env
#   2. Замените каждое значение CHANGE_ME... на свой боевой флаг формата BootCTF{...}.
#   3. Поднимите стенд:  make lecture-up LECTURE=01-intro
#
# flags.real.env в Git НЕ входит (см. .gitignore) и студентам НЕ выдаётся.
# Здесь только флаги времени выполнения (их отдаёт контейнер). Файловые флаги —
# в заданиях crypto (AES), forensics (дамп), reverse (ELF), stego (PNG) — одинаковы
# для всех и меняются только пересборкой задания, в этом файле их нет.
#
# Умолчания для локального запуска студентами лежат в <задание>/deploy/flags.env.defaults
# и начинаются с BootCTF{default_...}. make lecture-up не запустится, пока здесь
# остаются заготовки CHANGE_ME.

# web-portal «Портал»
WEB_FLAG_1=BootCTF{CHANGE_ME_web_view_source}
WEB_FLAG_2=BootCTF{CHANGE_ME_web_hotkey_js}
WEB_FLAG_3=BootCTF{CHANGE_ME_web_api_header}
WEB_FLAG_4=BootCTF{CHANGE_ME_web_ssti_config}
WEB_FLAG_5=BootCTF{CHANGE_ME_web_response_header}
WEB_FLAG_6=BootCTF{CHANGE_ME_web_ssti_rce}

# crypto-xor-oracle «Шифратор» (флаг 3 — файловый, в backup.tar, здесь не задаётся)
CRYPTO_FLAG_1=BootCTF{CHANGE_ME_crypto_caesar}
CRYPTO_FLAG_2=BootCTF{CHANGE_ME_crypto_xor}
CRYPTO_FLAG_HIDDEN=BootCTF{CHANGE_ME_crypto_keyreuse}
# Необязательно: свой секретный ключ XOR (96 hex-символов = 48 байт). Если не менять,
# используется ключ из deploy/flags.env.defaults.
# CRYPTO_XOR_KEY=00112233...

# forensics-ftp-backup «Резервная копия» (флаги 1–3 — в дампе; здесь только скрытый)
FORENSICS_FLAG_HIDDEN=BootCTF{CHANGE_ME_forensics_hidden_dir}

# pwn-gatekeeper «Турникет»
PWN_FLAG_1=BootCTF{CHANGE_ME_pwn_ret2win}
